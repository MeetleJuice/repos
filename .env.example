# Import your local Desktop .env or .env.txt using Models > Choose your API key file.
# Never commit actual keys. Empty/missing providers are skipped during setup.
GEMINI_API_KEY=
GROQ_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
REQUESTY_API_KEY=
HUGGINGFACE_API_KEY=

# Common aliases also work:
# GOOGLE_API_KEY / GOOGLE_GENAI_API_KEY -> GEMINI_API_KEY
# OPENROUTER_KEY -> OPENROUTER_API_KEY
# CLOUDFLARE_API_KEY / CF_API_TOKEN -> CLOUDFLARE_API_TOKEN (Workers AI bearer token)
# CF_ACCOUNT_ID -> CLOUDFLARE_ACCOUNT_ID (32 hexadecimal characters)
# NVIDIA_NIM_API_KEY / NIM_API_KEY -> NVIDIA_API_KEY
# REQUESTY_KEY -> REQUESTY_API_KEY
# HF_TOKEN / HF_API_KEY / HUGGINGFACEHUB_API_TOKEN -> HUGGINGFACE_API_KEY
# A Cloudflare global API key is not a Workers AI bearer token.
# Account ID is required for Cloudflare; keep it local rather than sharing it in chat.
# Optional existing local service override (read from local .env; no cloud keys needed):
# OLLAMA_URL=http://127.0.0.1:11434
