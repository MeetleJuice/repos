{
  "title": "Neon Dodge",
  "summary": "A polished single-player browser arcade game using HTML Canvas and a Python standard-library server.",
  "features": [
    "Server Health Endpoint",
    "Game Interface (HTML/Canvas)",
    "Player Movement Controls",
    "Obstacle Spawning & Collision",
    "Scoring System",
    "High Score Persistence (SQLite)"
  ],
  "out_of_scope": [
    "Multiplayer support",
    "External assets or CDNs",
    "Authentication systems"
  ],
  "risks": [
    "Browser compatibility for Canvas API",
    "Mobile touch event handling variations",
    "Performance on low-end devices"
  ],
  "tasks": [
    {
      "title": "Setup Server and Health Endpoint",
      "instructions": "Create app.py with create_server(host, port) returning HTTPServer. Implement GET /health returning {\"status\":\"ok\"}. Configure static file serving for current directory to serve index.html.",
      "feature_indexes": [
        0,
        1
      ]
    },
    {
      "title": "Implement Game Client Logic",
      "instructions": "Create index.html with Canvas. Implement JS game loop: Player movement (A/D/Arrows), Obstacle spawning, Collision detection, Score tracking. Ensure touch controls are bound.",
      "feature_indexes": [
        1,
        2,
        3,
        4
      ]
    },
    {
      "title": "Implement Persistence API",
      "instructions": "Create SQLite database in project directory. Implement GET /api/scores to list high scores and POST /api/scores to save a new score with name and value.",
      "feature_indexes": [
        5
      ]
    },
    {
      "title": "Integration and UI Polish",
      "instructions": "Verify all endpoints work together. Add Start/Game Over screens in HTML/JS. Ensure difficulty increases over time. Run final acceptance checks.",
      "feature_indexes": [
        0,
        1,
        2,
        3,
        4,
        5
      ]
    }
  ],
  "checks": [
